# Copy to .env and fill in.

# Admin login: a bcrypt hash. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# IMPORTANT: paste the entire hash starting with `$2b$...` — no quotes, no spaces.
AEGIS_ADMIN_PASSWORD_HASH=

# JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_JWT_SECRET=

# WSL distro that hosts the bash scripts. Run `wsl -l -v` to see options.
AEGIS_WSL_DISTRO=Ubuntu

# Absolute path to the aegis_final project on the Windows host, in WSL form.
# Example: /mnt/c/Users/mazen/Downloads/aegis_final
AEGIS_PROJECT_DIR_WSL=/mnt/c/Users/mazen/Downloads/aegis_final

# --- Copilot / LLM configuration -------------------------------------------
# Leave AEGIS_LLM_API_KEY blank to disable the Copilot tab entirely.
#
# Choose ONE provider:
#
#   AEGIS_LLM_PROVIDER=anthropic
#     AEGIS_LLM_MODEL=claude-sonnet-4-6  (or claude-opus-4-7)
#     AEGIS_LLM_API_KEY=sk-ant-...
#
#   AEGIS_LLM_PROVIDER=openai_compat   # works for Mistral, OpenAI, Groq, Together, ...
#     AEGIS_LLM_BASE_URL=https://api.mistral.ai/v1
#     AEGIS_LLM_MODEL=mistral-large-latest
#     AEGIS_LLM_API_KEY=...
#
AEGIS_LLM_PROVIDER=anthropic
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=claude-sonnet-4-6
AEGIS_LLM_BASE_URL=

# Legacy: still honored as a fallback when AEGIS_LLM_API_KEY is unset and
# the provider is anthropic.
ANTHROPIC_API_KEY=

# CORS origin for the Vite dev server.
AEGIS_CORS_ORIGIN=http://localhost:5173
