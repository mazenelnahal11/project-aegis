# Copy to .env and fill in.

# --- Admin auth -------------------------------------------------------------
# Bcrypt hash. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
AEGIS_ADMIN_PASSWORD_HASH=

# JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_JWT_SECRET=

# --- Runtime ----------------------------------------------------------------
AEGIS_WSL_DISTRO=Ubuntu
AEGIS_PROJECT_DIR_WSL=/mnt/c/Users/mazen/Downloads/aegis_final

# --- Copilot / LLM ---------------------------------------------------------
# Leave AEGIS_LLM_API_KEY blank to disable the Copilot tab.
#
#   AEGIS_LLM_PROVIDER=anthropic
#     AEGIS_LLM_MODEL=claude-sonnet-4-6
#     AEGIS_LLM_API_KEY=sk-ant-...
#
#   AEGIS_LLM_PROVIDER=mistral    # works with any OpenAI-compatible endpoint
#     AEGIS_LLM_BASE_URL=https://api.mistral.ai/v1
#     AEGIS_LLM_MODEL=mistral-large-latest
#     AEGIS_LLM_API_KEY=...
#
AEGIS_LLM_PROVIDER=anthropic
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=claude-sonnet-4-6
AEGIS_LLM_BASE_URL=
ANTHROPIC_API_KEY=

# --- Grace-period notifier (Slack) -----------------------------------------
# Create at https://api.slack.com/apps → Incoming Webhooks.
# Leave blank to use the NullNotifier (warnings still recorded; no DM sent).
AEGIS_SLACK_WEBHOOK_URL=

# Base URL that recipients reach when clicking the ack link in the Slack DM.
# Point this at wherever your backend is publicly reachable (use a tunnel
# like ngrok for demos): https://abcd1234.ngrok.app
AEGIS_ACK_BASE_URL=http://localhost:8000

# Default grace window before a kill becomes a real gate.
AEGIS_GRACE_DEFAULT_MINUTES=30

# How often the background sweeper escalates expired warnings (seconds).
AEGIS_GRACE_EXPIRY_CHECK_SECONDS=30

# --- CORS -------------------------------------------------------------------
AEGIS_CORS_ORIGIN=http://localhost:5173
