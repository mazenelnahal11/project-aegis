# Copy to .env and fill in.

# Admin login: a bcrypt hash. Generate with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
AEGIS_ADMIN_PASSWORD_HASH=

# JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_JWT_SECRET=

# WSL distro that hosts the bash scripts. Run `wsl -l -v` to see options.
AEGIS_WSL_DISTRO=Ubuntu

# Absolute path to the aegis_final project on the Windows host, in WSL form.
# Example: /mnt/c/Users/mazen/Downloads/aegis_final
AEGIS_PROJECT_DIR_WSL=/mnt/c/Users/mazen/Downloads/aegis_final

# Anthropic API key for the Copilot tab. Leave blank to disable LLM features.
ANTHROPIC_API_KEY=

# Default Claude model.
AEGIS_LLM_MODEL=claude-sonnet-4-6

# CORS origin for the Vite dev server.
AEGIS_CORS_ORIGIN=http://localhost:5173
